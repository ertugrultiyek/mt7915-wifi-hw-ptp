From: Ertugrul Tiyek <ertugrultyk@gmail.com>
Subject: [PATCH] wifi: mt76: mt7915: add TSF-based virtual PTP hardware clock

Register a PHC backed by the 64-bit LPON TSF. Frequency/phase are
corrected in software only (time = offset + ((tsf - tsf_base) * mult) >> 21),
ported from the ath9k cyclecounter/timecounter PHC. No PLL/oscillator
registers are touched.

Exports mt7915_ptp_tsf_to_phc_time() / mt7915_ptp_tsf32_to_phc_time()
for the RX (RXD group 2) and TX status (TXS DW4) timestamp paths.

--- a/mt7915/Makefile
+++ b/mt7915/Makefile
@@ -9,3 +9,4 @@
 mt7915e-$(CONFIG_NL80211_TESTMODE) += testmode.o
 mt7915e-$(CONFIG_MT798X_WMAC) += soc.o
 mt7915e-$(CONFIG_DEV_COREDUMP) += coredump.o
+mt7915e-y += ptp.o
--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -1331,6 +1331,9 @@
 	dev->mt76.test_ops = &mt7915_testmode_ops;
 #endif
 
+	/* PHC is optional: a failure here must not take down the WLAN device */
+	mt7915_ptp_init(dev);
+
 	ret = mt76_register_device(&dev->mt76, true, mt76_rates,
 				   ARRAY_SIZE(mt76_rates));
 	if (ret)
@@ -1370,6 +1373,7 @@
 unreg_dev:
 	mt76_unregister_device(&dev->mt76);
 stop_hw:
+	mt7915_ptp_cleanup(dev);
 	mt7915_stop_hardware(dev);
 free_phy2:
 	if (phy2)
@@ -1379,6 +1383,7 @@
 
 void mt7915_unregister_device(struct mt7915_dev *dev)
 {
+	mt7915_ptp_cleanup(dev);
 	cancel_work_sync(&dev->dump_work);
 	cancel_work_sync(&dev->reset_work);
 	cancel_work_sync(&dev->rc_work);
--- a/mt7915/mt7915.h
+++ b/mt7915/mt7915.h
@@ -8,6 +8,7 @@
 #include <linux/ktime.h>
 #include "../mt76_connac.h"
 #include "regs.h"
+#include "ptp.h"
 
 #define MT7915_MAX_INTERFACES		19
 #define MT7915_WTBL_SIZE		288
@@ -340,6 +341,8 @@
 	struct reset_control *rstc;
 	void __iomem *dcm;
